PORT=4000
# PostgreSQL local en el puerto 5433 (servicio postgresql-x64-15)
DATABASE_URL="postgresql://postgres:TU_CONTRASENA@localhost:5433/chiapas_de_origen?schema=public"
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia_este_valor_por_uno_aleatorio"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
# Cuenta administradora inicial. Solo se usa al ejecutar "npm run db:seed".
# No se crea ningún admin si estas variables están vacías.
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@chiapasdeorigen.mx"
ADMIN_PASSWORD="cambia_esta_contrasena_segura"
